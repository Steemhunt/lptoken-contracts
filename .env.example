# Deployment signer. Never commit a funded private key.
PRIVATE_KEY="0x..."

# Required final LpTokenFactory owner after deployment wiring. Ownership transfer
# is immediate, so verify this non-zero address before broadcasting.
FACTORY_OWNER_TRANSFER_TARGET="0x..."

# Optional config override. The default is config/robinhood-mainnet.json.
DEPLOYMENT_CONFIG="config/robinhood-mainnet.json"

# Single RPC URL passed to `forge script --rpc-url`; Foundry broadcast does not use
# the web application's HTTP fallback transport. The fork-test helper probes all
# built-in public endpoints unless FORK_RPC_URL is supplied explicitly.
ROBINHOOD_RPC_URL="https://robinhood-rpc.publicnode.com"

# Base mainnet RPC used when DEPLOYMENT_CONFIG points to config/base-mainnet.json.
# The public endpoint is rate-limited; use a private provider for production broadcasts.
BASE_RPC_URL="https://mainnet.base.org"
